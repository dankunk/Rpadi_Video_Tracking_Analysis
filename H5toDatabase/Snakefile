# Snakefile

import glob
from pathlib import Path

configfile: "config.yaml"

# Dynamically gather all .h5 files based on the config map
def get_h5_files(wildcards):
    treatment = config["replicates"][wildcards.rep]["treatment"]
    h5_dir = f"{config['paths']['h5_root']}/{treatment}/{wildcards.rep}"
    
    files = glob.glob(f"{h5_dir}/*.h5")
    # print(f"DEBUG: Found {len(files)} files for {wildcards.rep}") # You can leave this in or remove it!
    return files

# Generate the expected intermediate parquet file names for a specific replicate
def get_intermediate_parquets(wildcards):
    h5_files = get_h5_files(wildcards)
    basenames = [Path(f).stem for f in h5_files]
    
    # STRICT FORWARD SLASHES - No os.path.join()
    out_dir = config["paths"]["output_dir"]
    return [f"{out_dir}/intermediate/{wildcards.rep}/{b}.parquet" for b in basenames]

# Start Rules

rule all:
    input:
        expand(config["paths"]["output_dir"] + "/final/{rep}_master.parquet", rep=config["replicates"].keys())

rule h5_spatial_assign:
    input:
        # F-strings inside the lambda are safe because they evaluate after Snakemake passes the wildcards
        h5 = lambda wildcards: f"{config['paths']['h5_root']}/{config['replicates'][wildcards.rep]['treatment']}/{wildcards.rep}/{wildcards.video}.h5",
        json = lambda wildcards: f"{config['paths']['roi_root']}/{config['replicates'][wildcards.rep]['json_file']}"
    output:
        # Standard string concat to protect the {rep} and {video} wildcard brackets
        parquet = temp(config["paths"]["output_dir"] + "/intermediate/{rep}/{video}.parquet")
    log:
        "logs/process_{rep}_{video}.log"
    shell:
        """
        python scripts/h5_spatial_assign.py \
            --h5_in "{input.h5}" \
            --json_in "{input.json}" \
            --parquet_out "{output.parquet}" > "{log}" 2>&1
        """

rule merge_replicate:
    input:
        get_intermediate_parquets
    output:
        master_parquet = config["paths"]["output_dir"] + "/final/{rep}_master.parquet"
    params:
        # Build the string safely here using standard Python syntax
        input_dir = config["paths"]["output_dir"] + "/intermediate/{rep}"
    log:
        "logs/merge_{rep}.log"
    shell:
        """
        python scripts/merge_replicate.py \
            --input_dir "{params.input_dir}" \
            --master_out "{output.master_parquet}" > "{log}" 2>&1
        """