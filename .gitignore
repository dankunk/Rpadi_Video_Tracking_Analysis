# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# hide long log directories and large output directories from H5toDatabase project
H5toDatabase/logs/*
H5toDatabase/output/*
# hide testing parquet files from H5toDatabase project
H5toDatabase/*.parquet


# also hide .snakemake except for our major snakemake logs...
# ignore everything inside .snakemake...
H5toDatabase/.snakemake/*
# ...except for the snakemake logs directory!
H5toDatabase/!.snakemake/log